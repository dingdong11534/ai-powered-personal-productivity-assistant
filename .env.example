# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# `.env.example` is the only one that should ever be committed.

# --- General ---
APP_NAME="Personal Productivity Assistant"
ENVIRONMENT=development       # development | test | production
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# --- Storage ---
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/assistant.db

# --- AI layer (leave AI_PROVIDER=none until Phase 4) ---
AI_PROVIDER=none              # none | openai | anthropic | groq | ollama
AI_API_KEY=
